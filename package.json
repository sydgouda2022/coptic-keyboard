{
  "name": "@sydgouda2022/coptic-keyboard",
  "version": "1.0.0",
  "description": "Standalone Unicode Coptic prediction engine and accessible embeddable keyboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./styles/keyboard.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./prediction": {
      "types": "./types/index.d.mts",
      "import": "./src/keyboard_search.mjs"
    },
    "./styles.css": "./styles/keyboard.css",
    "./lexicon.json": "./release/lexicon.json",
    "./manifest.json": "./release/manifest.json"
  },
  "files": [
    "src/*.mjs",
    "types/*.d.mts",
    "styles/*.css",
    "release/lexicon.json",
    "release/manifest.json",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit": "python -m unittest discover -s tests -p 'test_*.py' -v"
  }
}
