{
  "name": "@sydgouda2022/coptic-keyboard",
  "version": "2.1.0",
  "description": "Headless Coptic Unicode keyboard API, predictive lexicon, and pure editing functions",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./prediction": {
      "types": "./types/prediction.d.mts",
      "import": "./src/core.mjs"
    },
    "./editing": {
      "types": "./types/editing.d.mts",
      "import": "./src/editor.mjs"
    },
    "./lexicon": {
      "types": "./types/lexicon.d.mts",
      "import": "./src/lexicon.mjs"
    },
    "./data/lexicon.json": "./release/lexicon.json",
    "./data/manifest.json": "./release/manifest.json"
  },
  "files": [
    "src/*.mjs",
    "types/*.d.mts",
    "release/lexicon.json",
    "release/manifest.json",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit": "python tools/verify_release.py && python -m unittest discover -s tests -p 'test_*.py' -v"
  }
}
